---
/**
 * Responsive image: AVIF + WebP with a JPEG/PNG fallback, srcset at standard widths, explicit
 * dimensions (no layout shift), lazy by default. Use `priority` for the page's LCP image only.
 *
 * Crops are done in CSS by the parent (aspect-ratio + object-fit: cover, as in the prototype);
 * `position` carries the prototype's object-position.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { DEFAULT_WIDTHS, IMAGE_QUALITY, usableWidths } from '../../lib/images';

interface Props {
  src: ImageMetadata;
  /** Required. Pass "" only for purely decorative images. */
  alt: string;
  /** Rendered size hint for the browser, e.g. "(min-width: 980px) 560px, 100vw". */
  sizes?: string;
  widths?: number[];
  /** CSS object-position from the prototype crop, e.g. "70% 30%". */
  position?: string;
  /** LCP image: eager, fetchpriority=high. */
  priority?: boolean;
  class?: string;
}

const {
  src,
  alt,
  sizes = '100vw',
  widths = DEFAULT_WIDTHS,
  position,
  priority = false,
  class: className,
} = Astro.props;

const finalWidths = usableWidths(src, widths);
---

<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  widths={finalWidths}
  sizes={sizes}
  quality={IMAGE_QUALITY}
  loading={priority ? 'eager' : 'lazy'}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : undefined}
  class={className}
  style={position ? `object-position: ${position}` : undefined}
/>
