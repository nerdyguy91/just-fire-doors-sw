---
/**
 * Hairline grid of linked situation cards (home "Where can we take some weight off your list?").
 */
interface Props {
  title: string;
  items: { title: string; body: string; cta: string; href: string }[];
  id?: string;
}

const { title, items, id = 'situations-title' } = Astro.props;
---

<section class="situations" aria-labelledby={id}>
  <div class="situations__inner">
    <h2 {id} class="situations__title">
      {title}
    </h2>
    <ul class="situations__grid" role="list">
      {items.map((item, i) => (
        <li>
          <a class="situation" href={item.href}>
            <span class="situation__n">Situation {String(i + 1).padStart(2, '0')}</span>
            <span class="situation__title">{item.title}</span>
            <span class="situation__body">{item.body}</span>
            <span class="situation__cta">{item.cta} →</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .situations {
    border-bottom: 1px solid var(--jfd-rule);
  }
  .situations__inner {
    max-width: var(--jfd-max);
    margin: 0 auto;
    padding: var(--jfd-section-y-fluid) var(--jfd-gutter-fluid);
  }
  .situations__title {
    font-family: var(--jfd-font-display);
    font-size: clamp(34px, 4vw, 52px);
    font-weight: 600;
    line-height: 1.1;
    margin: 0 0 40px;
    max-width: 22ch;
  }
  .situations__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 1px;
    background: var(--jfd-rule);
    border: 1px solid var(--jfd-rule);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .situations__grid li {
    min-width: 0;
    display: flex;
  }
  .situation {
    flex: 1;
    background: var(--jfd-ground);
    padding: 34px clamp(20px, 5.5vw, 32px) 30px;
    display: block;
    color: var(--jfd-graphite);
    transition: background 0.2s ease;
  }
  .situation:hover {
    background: var(--jfd-surface);
    color: var(--jfd-graphite);
  }
  .situation__n {
    display: block;
    font-family: var(--jfd-font-mono);
    font-size: 11px;
    text-transform: uppercase;
    color: var(--jfd-ink-4);
    margin-bottom: 18px;
  }
  .situation__title {
    display: block;
    font-family: var(--jfd-font-display);
    font-size: 28px;
    font-weight: 600;
    line-height: 1.22;
    margin-bottom: 12px;
    text-wrap: pretty;
  }
  .situation__body {
    display: block;
    font-size: 16px;
    line-height: 1.58;
    color: var(--jfd-ink-3);
    margin-bottom: 20px;
    max-width: 42ch;
  }
  .situation__cta {
    display: inline-block;
    font-size: 15px;
    font-weight: 500;
    color: var(--jfd-action);
    border-bottom: 1px solid var(--jfd-underline);
    padding-bottom: 2px;
  }
</style>
