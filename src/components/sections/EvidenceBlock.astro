---
/**
 * Close-out evidence section (prototype JfdEvidence): intro, numbered list of what the team
 * needs to know, optional chain, "Closed on the report" outcome, and DDS app screenshots in
 * phone frames.
 */
import type { ImageMetadata } from 'astro';
import Img from '../ui/Img.astro';
import gapChecks from '../../assets/images/evidence/dds-gap-checks.jpeg';
import installChecks from '../../assets/images/evidence/dds-install-checks.jpeg';

interface Shot {
  image: ImageMetadata;
  alt: string;
  label: string;
  position?: string;
}

interface Props {
  eyebrow: string;
  title: string;
  intro?: string[];
  listTitle: string;
  items: string[];
  chain?: string[];
  outcome: string;
  closing?: string;
  shots?: Shot[];
  caption?: string;
  id?: string;
}

const {
  eyebrow,
  title,
  intro = [],
  listTitle,
  items,
  chain = [],
  outcome,
  closing,
  shots = [
    {
      image: gapChecks,
      alt: 'Door Data Systems record showing gap checks with photos per door',
      label: 'Gap checks · photo per measurement',
      position: '50% 0%',
    },
    {
      image: installChecks,
      alt: 'Door Data Systems installation checks with photo evidence',
      label: 'Installation checks · 2 of 22',
      position: '50% 0%',
    },
  ],
  caption = 'Door Data Systems (DDS) — live JFD records, local council project',
  id = 'evidence-title',
} = Astro.props;
---

<section class="evidence" id="evidence" aria-labelledby={id}>
  <div class="evidence__inner">
    <div class="evidence__text">
      <p class="jfd-eyebrow">{eyebrow}</p>
      <h2 {id} class="jfd-h2 evidence__title">
        {title}
      </h2>
      {intro.map((line) => (
        <p class="evidence__intro">{line}</p>
      ))}
      <p class="evidence__list-title">{listTitle}</p>
      <ol class="evidence__list" role="list">
        {items.map((item, i) => (
          <li>
            <span class="evidence__n" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span>{item}</span>
          </li>
        ))}
      </ol>
      {chain.length > 0 && (
        <p class="evidence__chain">
          {chain.map((step, i) => (
            <span>
              {step}
              {i < chain.length - 1 && (
                <span class="evidence__sep" aria-hidden="true">
                  →
                </span>
              )}
            </span>
          ))}
        </p>
      )}
      <div class="evidence__outcome">
        <span class="jfd-status jfd-status--closed evidence__status">Closed on the report</span>
        <p class="evidence__outcome-text">{outcome}</p>
        {closing && <p class="evidence__closing">{closing}</p>}
      </div>
    </div>
    <figure class="evidence__figure">
      <div class="evidence__shots">
        {shots.map((s) => (
          <div class="evidence__shot">
            <div class="evidence__frame">
              <div class="evidence__screen">
                <Img
                  src={s.image}
                  alt={s.alt}
                  position={s.position ?? '50% 0%'}
                  sizes="(min-width: 1240px) 250px, (min-width: 700px) 22vw, 80vw"
                  widths={[360, 640]}
                />
              </div>
            </div>
            <span class="evidence__label">{s.label}</span>
          </div>
        ))}
      </div>
      <figcaption class="evidence__caption">{caption}</figcaption>
    </figure>
  </div>
</section>

<style>
  .evidence {
    background: var(--jfd-surface);
    border-bottom: 1px solid var(--jfd-rule);
  }
  .evidence__inner {
    max-width: var(--jfd-max);
    margin: 0 auto;
    padding: var(--jfd-section-y-fluid) var(--jfd-gutter-fluid);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: clamp(28px, 6vw, 56px) 80px;
    align-items: start;
  }
  .evidence__text {
    min-width: 0;
  }
  .evidence__title {
    margin: 0 0 22px;
    max-width: 18ch;
  }
  .evidence__intro {
    font-size: 17.5px;
    line-height: 1.62;
    color: var(--jfd-ink-2);
    margin: 0 0 16px;
    max-width: 50ch;
    text-wrap: pretty;
  }
  .evidence__list-title {
    font-family: var(--jfd-font-mono);
    font-size: 10.5px;
    text-transform: uppercase;
    color: var(--jfd-ink-3);
    margin: 26px 0 4px;
  }
  .evidence__list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 52ch;
  }
  .evidence__list li {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    gap: 10px;
    padding: 11px 0;
    border-top: 1px solid var(--jfd-rule-soft);
    font-size: 16px;
    line-height: 1.5;
    color: var(--jfd-graphite);
  }
  .evidence__n {
    font-family: var(--jfd-font-mono);
    font-size: 11.5px;
    color: var(--jfd-ink-4);
    padding-top: 3px;
  }
  .evidence__chain {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin: 24px 0 0;
    padding: 14px 16px;
    background: var(--jfd-tint);
    font-family: var(--jfd-font-mono);
    font-size: 12px;
    text-transform: uppercase;
    color: var(--jfd-graphite);
  }
  .evidence__chain > span {
    display: inline-flex;
    gap: 12px;
    align-items: center;
  }
  .evidence__sep {
    color: #7fa6c2;
  }
  .evidence__outcome {
    margin-top: 30px;
    padding-top: 22px;
    border-top: 1px solid var(--jfd-rule);
  }
  .evidence__status {
    margin-bottom: 10px;
  }
  .evidence__outcome-text {
    font-family: var(--jfd-font-display);
    font-size: clamp(26px, 2.6vw, 32px);
    font-weight: 600;
    line-height: 1.18;
    margin: 0 0 12px;
    max-width: 26ch;
    text-wrap: pretty;
  }
  .evidence__closing {
    font-size: 16px;
    line-height: 1.6;
    color: var(--jfd-ink-3);
    margin: 0;
    max-width: 48ch;
  }
  .evidence__figure {
    min-width: 0;
    margin: 0;
  }
  .evidence__shots {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 16px;
    background: var(--jfd-tint);
    border: 1px solid var(--jfd-rule);
    padding: 20px;
  }
  .evidence__shot {
    min-width: 0;
  }
  .evidence__frame {
    background: #121620;
    padding: 8px;
    border: 1px solid var(--jfd-dark-rule);
  }
  .evidence__screen {
    aspect-ratio: 9 / 16;
    overflow: hidden;
    background: #212634;
  }
  .evidence__screen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .evidence__label {
    display: block;
    font-family: var(--jfd-font-mono);
    font-size: 10.5px;
    text-transform: uppercase;
    color: var(--jfd-ink-3);
    margin-top: 10px;
    line-height: 1.5;
  }
  .evidence__caption {
    font-family: var(--jfd-font-mono);
    font-size: 10.5px;
    text-transform: uppercase;
    color: var(--jfd-ink-4);
    margin-top: 12px;
    line-height: 1.6;
  }
</style>
