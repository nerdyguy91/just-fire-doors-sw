---
/**
 * Page hero shell (prototype "01 Hero" sections). Two-column grid: content + optional aside.
 *
 * Slots
 *   title     H1 content. Use <span class="jfd-accent"> for the blue second half.
 *   default   Lead copy, actions and notes. Shared body classes (below) cover the common cases;
 *             anything page-specific is styled by the page.
 *   aside     Right-hand panel (record, photo, file stack…).
 *
 * Body classes available to slot content:
 *   .hero-lead      19px graphite lead          .hero-body     16.5px secondary paragraph
 *   .hero-display   27px display sub-headline   .hero-actions  button + link row
 *   .hero-actions--stack                         .hero-note     ruled footnote
 *   .hero-prompt    white bordered prompt box (text + link)
 */
import Breadcrumbs from '../layout/Breadcrumbs.astro';
import type { Breadcrumb } from '../../lib/seo';

interface Props {
  breadcrumbs?: Breadcrumb[];
  eyebrow?: string;
  /** H1 scale: home, service pages (default), large (projects/about), quote. */
  size?: 'home' | 'service' | 'large' | 'quote';
  /** Vertical padding: default, compact (contact/quote), home. */
  density?: 'default' | 'compact' | 'home';
  align?: 'start' | 'center';
  /** Max width of the content column in px. */
  contentWidth?: number;
  /** Accessible name for the section; defaults to the H1 via aria-labelledby. */
  id?: string;
}

const {
  breadcrumbs,
  eyebrow,
  size = 'service',
  density = 'default',
  align = 'start',
  contentWidth = 580,
  id = 'page-title',
} = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section
  class:list={['page-hero', `page-hero--${density}`, `page-hero--align-${align}`]}
  aria-labelledby={id}
>
  <div class="page-hero__grid">
    <div class="page-hero__content" style={`max-width: ${contentWidth}px`}>
      {breadcrumbs && (
        <Breadcrumbs
          items={breadcrumbs}
          class={`page-hero__crumbs page-hero__crumbs--${density}`}
        />
      )}
      {eyebrow && <p class="page-hero__eyebrow">{eyebrow}</p>}
      <h1 {id} class:list={['page-hero__title', `page-hero__title--${size}`]}>
        <slot name="title" />
      </h1>
      <slot />
    </div>
    {hasAside && (
      <div class="page-hero__aside">
        <slot name="aside" />
      </div>
    )}
  </div>
</section>

<style>
  .page-hero {
    border-bottom: 1px solid var(--jfd-rule);
  }
  .page-hero__grid {
    max-width: var(--jfd-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    padding: clamp(38px, 6.4vw, 64px) var(--jfd-gutter-fluid) clamp(43px, 7.2vw, 72px);
    gap: clamp(28px, 6vw, 56px) 64px;
    align-items: start;
  }
  .page-hero--compact .page-hero__grid {
    padding: clamp(34px, 5.6vw, 56px) var(--jfd-gutter-fluid);
    gap: clamp(28px, 6vw, 40px) 64px;
  }
  .page-hero--home .page-hero__grid {
    padding: clamp(40px, 8.4vw, 84px) var(--jfd-gutter-fluid) clamp(43px, 7.2vw, 72px);
    gap: clamp(32px, 6vw, 64px);
  }
  .page-hero--align-center .page-hero__grid {
    align-items: center;
  }
  .page-hero__content,
  .page-hero__aside {
    min-width: 0;
  }

  .page-hero :global(.page-hero__crumbs) {
    margin-bottom: 26px;
  }
  .page-hero :global(.page-hero__crumbs--compact) {
    margin-bottom: 22px;
  }

  .page-hero__eyebrow {
    letter-spacing: normal;
    font-family: var(--jfd-font-mono);
    font-size: 12.5px;
    text-transform: uppercase;
    color: var(--jfd-ink-3);
    margin: 0 0 22px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--jfd-rule);
    line-height: 1.6;
  }

  .page-hero__title {
    letter-spacing: normal;
    font-family: var(--jfd-font-display);
    font-weight: 600;
    line-height: 1.02;
    margin: 0 0 24px;
    text-wrap: balance;
  }
  .page-hero__title--home {
    font-size: clamp(40px, 6.6vw, 84px);
    text-wrap: pretty;
  }
  .page-hero__title--service {
    font-size: clamp(38px, 5.8vw, 76px);
  }
  .page-hero__title--large {
    font-size: clamp(40px, 6.4vw, 84px);
  }
  .page-hero__title--quote {
    font-size: clamp(42px, 5.2vw, 68px);
    line-height: 1.03;
    margin-bottom: 20px;
  }
  .page-hero--compact .page-hero__title {
    margin-bottom: 20px;
  }

  /* Shared body classes for slot content */
  .page-hero :global(.hero-lead) {
    font-size: 19px;
    line-height: 1.58;
    color: var(--jfd-graphite);
    margin: 0 0 16px;
    max-width: 46ch;
    text-wrap: pretty;
  }
  .page-hero :global(.hero-body) {
    font-size: 16.5px;
    line-height: 1.62;
    color: var(--jfd-ink-2);
    margin: 0 0 32px;
    max-width: 52ch;
    text-wrap: pretty;
  }
  .page-hero :global(.hero-display) {
    font-family: var(--jfd-font-display);
    font-size: 27px;
    font-weight: 600;
    line-height: 1.2;
    color: var(--jfd-graphite);
    margin: 0 0 14px;
    max-width: 30ch;
  }
  .page-hero :global(.hero-actions) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }
  .page-hero :global(.hero-actions--stack) {
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }
  .page-hero :global(.hero-note) {
    font-size: 15px;
    line-height: 1.6;
    color: var(--jfd-ink-3);
    margin: 30px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--jfd-rule);
    max-width: 52ch;
  }
  .page-hero :global(.hero-note strong) {
    color: var(--jfd-graphite);
  }
  .page-hero :global(.hero-prompt) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    background: var(--jfd-surface);
    border: 1px solid var(--jfd-rule-strong);
    padding: 14px 18px;
  }
  .page-hero :global(.hero-prompt > span) {
    font-size: 15.5px;
    font-weight: 600;
    color: var(--jfd-graphite);
  }
</style>
