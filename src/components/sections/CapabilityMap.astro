---
/**
 * The four services around one specialist (Why JFD "The clue is in the name"): a 2×2 grid of
 * linked service cells with the JFD badge in the centre on wide screens (a brand bar above the grid
 * on narrow ones), then a close-out band linking to the close-out evidence.
 * Production: the badge shows the client's logo in place of the prototype's typeset wordmark.
 */
import { services } from '../../data/services';
import Wordmark from '../layout/Wordmark.astro';

interface Props {
  /** Where the close-out band links. */
  closeOutHref: string;
}

const { closeOutHref } = Astro.props;
---

<div class="capmap">
  <div class="capmap__brand capmap__brand--bar" aria-hidden="true">
    <Wordmark variant="on-dark" height={30} lazy />
  </div>
  <ul class="capmap__grid" role="list">
    {services.map((s) => (
      <li>
        <a class="capmap__cell" href={s.path}>
          <span class="capmap__verb">{s.verb}</span>
          <span class="capmap__title">{s.mapTitle}</span>
          <span class="capmap__body">{s.summary}</span>
        </a>
      </li>
    ))}
  </ul>
  <div class="capmap__brand capmap__brand--centre" aria-hidden="true">
    <span class="capmap__bar"></span>
    <Wordmark variant="on-dark" height={32} lazy />
  </div>
</div>
<a class="capmap__close jfd-on-dark" href={closeOutHref}>
  <span class="capmap__close-label">Close · across every service</span>
  <span class="capmap__close-title">Clear close-out</span>
  <span class="capmap__close-body">
    Leaving your team with usable records of the work completed.
  </span>
</a>

<style>
  .capmap {
    position: relative;
  }
  .capmap__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    border: 1px solid var(--jfd-rule);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .capmap__grid li {
    display: flex;
    min-width: 0;
  }
  .capmap__cell {
    flex: 1;
    outline: 1px solid var(--jfd-rule);
    background: var(--jfd-ground);
    min-height: 230px;
    padding: 26px 26px 28px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    color: var(--jfd-graphite);
    transition: background 0.2s ease;
  }
  .capmap__cell:hover {
    background: var(--jfd-surface);
    color: var(--jfd-graphite);
  }
  .capmap__verb {
    display: block;
    font-family: var(--jfd-font-mono);
    font-size: 11px;
    text-transform: uppercase;
    color: var(--jfd-action);
    margin-bottom: 10px;
  }
  .capmap__title {
    display: block;
    font-family: var(--jfd-font-display);
    font-size: clamp(22px, 2.4vw, 28px);
    font-weight: 600;
    line-height: 1.15;
    margin-bottom: 8px;
    max-width: 16ch;
  }
  .capmap__body {
    display: block;
    font-size: 15px;
    line-height: 1.5;
    color: var(--jfd-ink-3);
    max-width: 32ch;
  }
  .capmap__brand--bar {
    background: var(--jfd-graphite);
    padding: 14px 20px;
    display: flex;
    align-items: center;
  }
  .capmap__brand--centre {
    display: none;
  }
  .capmap__bar {
    display: block;
    width: 28px;
    height: 3px;
    background: var(--jfd-azure);
    margin: 0 auto 10px;
  }

  @media (min-width: 720px) {
    .capmap__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .capmap__brand--bar {
      display: none;
    }
    .capmap__brand--centre {
      display: block;
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      background: var(--jfd-graphite);
      padding: 16px 20px;
      border: 4px solid #ffffff;
      box-shadow: 0 0 0 1px var(--jfd-rule);
    }
    /* Corner alignment, as in the prototype: text pushed towards the outer corners. */
    .capmap__grid li:nth-child(2) .capmap__cell,
    .capmap__grid li:nth-child(4) .capmap__cell {
      align-items: flex-end;
      text-align: right;
    }
    .capmap__grid li:nth-child(3) .capmap__cell,
    .capmap__grid li:nth-child(4) .capmap__cell {
      justify-content: flex-end;
    }
  }

  .capmap__close {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 24px;
    background: var(--jfd-graphite);
    color: var(--jfd-dark-heading);
    padding: 20px 26px;
    border-top: 3px solid var(--jfd-status-closed);
  }
  .capmap__close:hover {
    background: #2c3237;
    color: var(--jfd-dark-heading);
  }
  .capmap__close-label {
    font-family: var(--jfd-font-mono);
    font-size: 11px;
    text-transform: uppercase;
    color: var(--jfd-azure-soft);
  }
  .capmap__close-title {
    font-family: var(--jfd-font-display);
    font-size: 25px;
    font-weight: 600;
  }
  .capmap__close-body {
    font-size: 15px;
    color: var(--jfd-dark-ink-2);
    flex: 1 1 300px;
  }
</style>
