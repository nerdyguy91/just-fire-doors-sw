---
/**
 * Service cards grid (home "Fire door services across the South West", /services/ hub).
 * Data from src/data/services.ts. Card images are decorative: the card text names the service.
 */
import { services as allServices, type Service } from '../../data/services';
import Img from '../ui/Img.astro';

interface Props {
  title: string;
  intro?: string;
  services?: Service[];
  /** Heading level for the section title (h2 on the home page, h2 on the hub below its H1). */
  id?: string;
  tint?: boolean;
}

const { title, intro, services = allServices, id = 'services-title', tint = true } = Astro.props;
---

<section class:list={['svc', { 'svc--tint': tint }]} id="services" aria-labelledby={id}>
  <div class="svc__inner">
    <div class="svc__head">
      <h2 {id} class="svc__title">
        {title}
      </h2>
      {intro && <p class="svc__intro">{intro}</p>}
    </div>
    <ul class="svc__grid" role="list">
      {services.map((s, i) => (
        <li>
          <a class="svc-card" href={s.path}>
            <span class="svc-card__media">
              <Img
                src={s.card.image}
                alt=""
                position={s.card.position}
                sizes="(min-width: 1240px) 380px, (min-width: 700px) 45vw, 90vw"
              />
            </span>
            <span class="svc-card__body">
              <span class="svc-card__n">{String(i + 1).padStart(2, '0')}</span>
              <span class="svc-card__title">{s.title}</span>
              <span class="svc-card__text">{s.cardBody}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .svc {
    border-bottom: 1px solid var(--jfd-rule);
  }
  .svc--tint {
    background: var(--jfd-tint);
  }
  .svc__inner {
    max-width: var(--jfd-max);
    margin: 0 auto;
    padding: var(--jfd-section-y-fluid) var(--jfd-gutter-fluid);
  }
  .svc__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin-bottom: 40px;
  }
  .svc__title {
    font-family: var(--jfd-font-display);
    font-size: clamp(34px, 4vw, 52px);
    font-weight: 600;
    line-height: 1.1;
    margin: 0;
  }
  .svc__intro {
    font-size: 16px;
    color: var(--jfd-ink-3);
    margin: 0;
    max-width: 30ch;
    line-height: 1.55;
  }
  .svc__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 310px), 1fr));
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .svc__grid li {
    display: flex;
    min-width: 0;
  }
  .svc-card {
    flex: 1;
    display: block;
    background: var(--jfd-surface);
    border: 1px solid var(--jfd-rule);
    color: var(--jfd-graphite);
    transition: border-color 0.2s ease;
  }
  .svc-card:hover {
    border-color: var(--jfd-action);
    color: var(--jfd-graphite);
  }
  .svc-card__media {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-bottom: 1px solid var(--jfd-rule);
    background: var(--jfd-media-bg);
  }
  .svc-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .svc-card__body {
    display: block;
    padding: 24px 24px 26px;
  }
  .svc-card__n {
    display: block;
    font-family: var(--jfd-font-mono);
    font-size: 11px;
    text-transform: uppercase;
    color: var(--jfd-action);
    margin-bottom: 12px;
  }
  .svc-card__title {
    display: block;
    font-family: var(--jfd-font-display);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.28;
    margin-bottom: 10px;
  }
  .svc-card__text {
    display: block;
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--jfd-ink-3);
  }
</style>
