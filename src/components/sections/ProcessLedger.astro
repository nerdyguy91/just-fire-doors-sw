---
/**
 * Decide → Deliver → Close, ledger layout (home "How the work moves, end to end."). The prototype's
 * alternative "rail" layout is not ported (plan: ship the approved defaults only).
 */
import type { ImageMetadata } from 'astro';
import type { Tone } from '../../lib/tones';
import { toneVar } from '../../lib/tones';
import Img from '../ui/Img.astro';

export interface Stage {
  label: string;
  headline: string;
  body: string[];
  outcome: string;
  tone: Tone;
  image: ImageMetadata;
  alt: string;
  position?: string;
}

interface Props {
  title: string;
  intro: string;
  stages: Stage[];
  id?: string;
}

const { title, intro, stages, id = 'process-title' } = Astro.props;
---

<section class="ledger" id="process" aria-labelledby={id}>
  <div class="ledger__inner">
    <div class="ledger__head">
      <h2 {id} class="ledger__title">
        {title}
      </h2>
      <p class="ledger__intro">{intro}</p>
    </div>
    <ol class="ledger__stages" role="list">
      {stages.map((s, i) => (
        <li class="ledger__stage">
          <div class="ledger__rail" aria-hidden="true">
            <span class="ledger__n">{String(i + 1).padStart(2, '0')}</span>
            <span class="ledger__line" />
          </div>
          <div class="ledger__content">
            <div class="ledger__text">
              <h3 class="ledger__label">{s.label}</h3>
              <p class="ledger__headline">{s.headline}</p>
              {s.body.map((para) => (
                <p class="ledger__body">{para}</p>
              ))}
              <p class="ledger__outcome">
                <span
                  class="ledger__dot"
                  style={`background: ${toneVar(s.tone)}`}
                  aria-hidden="true"
                />
                <span class="jfd-visually-hidden">You end up with: </span>
                {s.outcome}
              </p>
            </div>
            <div class="ledger__media">
              <Img
                src={s.image}
                alt={s.alt}
                position={s.position}
                sizes="(min-width: 1100px) 480px, (min-width: 700px) 45vw, 90vw"
              />
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .ledger {
    border-bottom: 1px solid var(--jfd-rule);
    background: var(--jfd-surface);
  }
  .ledger__inner {
    max-width: var(--jfd-max);
    margin: 0 auto;
    padding: var(--jfd-section-y-fluid) var(--jfd-gutter-fluid);
  }
  .ledger__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin-bottom: 48px;
  }
  .ledger__title {
    font-family: var(--jfd-font-display);
    font-size: clamp(34px, 4vw, 50px);
    font-weight: 600;
    line-height: 1.1;
    margin: 0;
    max-width: 24ch;
  }
  .ledger__intro {
    font-size: 16px;
    color: var(--jfd-ink-3);
    margin: 0;
    max-width: 34ch;
    line-height: 1.55;
  }
  .ledger__stages {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ledger__stage {
    display: grid;
    grid-template-columns: clamp(44px, 6vw, 64px) minmax(0, 1fr);
    gap: 0 clamp(16px, 3.5vw, 40px);
    align-items: start;
    border-top: 1px solid var(--jfd-rule);
    padding: 36px 0;
  }
  .ledger__rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding-top: 4px;
    align-self: stretch;
  }
  .ledger__n {
    width: 44px;
    height: 44px;
    border: 1px solid var(--jfd-rule-strong);
    display: grid;
    place-items: center;
    font-family: var(--jfd-font-mono);
    font-size: 14px;
    color: var(--jfd-action);
    background: var(--jfd-ground);
  }
  .ledger__line {
    width: 1px;
    flex: 1;
    min-height: 60px;
    background: var(--jfd-rule);
  }
  .ledger__content {
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 24px 40px;
    align-items: start;
  }
  .ledger__text {
    min-width: 0;
  }
  .ledger__label {
    font-family: var(--jfd-font-mono);
    font-size: 15px;
    font-weight: 500;
    text-transform: uppercase;
    color: var(--jfd-action);
    margin: 0 0 14px;
  }
  .ledger__headline {
    font-family: var(--jfd-font-display);
    font-size: clamp(28px, 3vw, 38px);
    font-weight: 600;
    line-height: 1.16;
    margin: 0 0 14px;
    text-wrap: pretty;
  }
  .ledger__body {
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--jfd-ink-3);
    margin: 0 0 20px;
    max-width: 52ch;
  }
  .ledger__outcome {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: var(--jfd-tint);
    padding: 10px 14px;
    font-size: 15px;
    font-weight: 500;
    margin: 0;
  }
  .ledger__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .ledger__media {
    height: 240px;
    overflow: hidden;
    background: var(--jfd-media-bg);
    border: 1px solid var(--jfd-rule);
  }
  .ledger__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
