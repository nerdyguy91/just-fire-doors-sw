---
/**
 * Closing call to action on action-blue.
 *   split  prototype JfdFinalCta: primary route (title, body, button, optional "useful to tell us"
 *          list) and a bordered secondary route.
 *   home   home band: title, "Send it over.", body; button, link and tagline on the right.
 */
interface Link {
  label: string;
  href: string;
}

interface Props {
  variant?: 'split' | 'home';
  labelA?: string;
  title: string;
  /** Home variant: display line under the title. */
  kicker?: string;
  body?: string[];
  cta: Link;
  fields?: string[];
  labelB?: string;
  altTitle?: string;
  altBody?: string;
  altCta?: Link;
  id?: string;
  /** In-page anchor for the section. */
  anchor?: string;
}

const {
  variant = 'split',
  labelA = 'Get a quote',
  title,
  kicker,
  body = [],
  cta,
  fields = [],
  labelB = 'Or',
  altTitle,
  altBody,
  altCta,
  id = 'cta-title',
  anchor = 'quote',
} = Astro.props;
---

<section class:list={['cta', 'jfd-on-dark', `cta--${variant}`]} id={anchor} aria-labelledby={id}>
  <div class="cta__inner">
    <div class="cta__main">
      {variant === 'split' && <p class="cta__label">{labelA}</p>}
      <h2 {id} class="cta__title">
        {title}
      </h2>
      {kicker && <p class="cta__kicker">{kicker}</p>}
      {body.map((line) => (
        <p class="cta__body">{line}</p>
      ))}
      {variant === 'split' && (
        <a class="jfd-btn jfd-btn--inverse jfd-btn--lg cta__button" href={cta.href}>
          {cta.label}
        </a>
      )}
      {fields.length > 0 && (
        <>
          <p class="cta__label cta__label--fields">Useful to tell us</p>
          <ol class="cta__fields" role="list">
            {fields.map((f, i) => (
              <li>
                <span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                {f}
              </li>
            ))}
          </ol>
        </>
      )}
    </div>
    {variant === 'split' ? (
      <div class="cta__alt">
        <p class="cta__label">{labelB}</p>
        {altTitle && <h3 class="cta__alt-title">{altTitle}</h3>}
        {altBody && <p class="cta__alt-body">{altBody}</p>}
        {altCta && (
          <a class="jfd-link jfd-link--on-dark cta__alt-link" href={altCta.href}>
            {altCta.label} →
          </a>
        )}
        <p class="cta__tagline">
          One site. One backlog.
          <br />
          One defined piece of work.
        </p>
      </div>
    ) : (
      <div class="cta__actions">
        <a class="jfd-btn jfd-btn--inverse jfd-btn--lg cta__button-home" href={cta.href}>
          {cta.label}
        </a>
        {altCta && (
          <a class="jfd-link jfd-link--on-dark cta__alt-link" href={altCta.href}>
            {altCta.label} →
          </a>
        )}
        <p class="cta__tagline cta__tagline--home">
          One site. One backlog.
          <br />
          One defined piece of work.
        </p>
      </div>
    )}
  </div>
</section>

<style>
  .cta {
    background: var(--jfd-action-hover);
    color: #ffffff;
  }
  .cta__inner {
    max-width: var(--jfd-max);
    margin: 0 auto;
    padding: clamp(58px, 9.6vw, 96px) var(--jfd-gutter-fluid);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: clamp(28px, 6vw, 48px) 72px;
    align-items: start;
  }
  .cta--home .cta__inner {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    align-items: center;
  }
  .cta__main,
  .cta__alt,
  .cta__actions {
    min-width: 0;
  }
  .cta__label {
    font-family: var(--jfd-font-mono);
    font-size: 11.5px;
    text-transform: uppercase;
    color: var(--jfd-azure-pale);
    margin: 0 0 20px;
  }
  .cta__label--fields {
    font-size: 10.5px;
    margin: 36px 0 6px;
  }
  .cta__title {
    font-family: var(--jfd-font-display);
    font-size: clamp(38px, 4.6vw, 60px);
    font-weight: 600;
    line-height: 1.06;
    margin: 0 0 18px;
    text-wrap: pretty;
  }
  .cta--home .cta__title {
    font-size: clamp(38px, 4.8vw, 62px);
  }
  .cta__kicker {
    font-family: var(--jfd-font-display);
    font-size: 34px;
    font-weight: 500;
    margin: 0 0 22px;
    color: #ffffff;
  }
  .cta__body {
    font-size: 17.5px;
    line-height: 1.6;
    color: var(--jfd-azure-mist);
    margin: 0 0 12px;
    max-width: 46ch;
  }
  .cta--home .cta__body {
    margin: 0;
  }
  .cta__button {
    margin-top: 14px;
  }
  .cta__fields {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
    column-gap: 28px;
    max-width: 560px;
  }
  .cta__fields li {
    display: flex;
    gap: 12px;
    align-items: baseline;
    padding: 11px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.22);
    font-size: 15.5px;
    color: #ffffff;
  }
  .cta__fields li span {
    font-family: var(--jfd-font-mono);
    font-size: 11px;
    color: var(--jfd-azure-pale);
  }
  .cta__alt {
    border: 1px solid rgba(255, 255, 255, 0.35);
    padding: 34px clamp(20px, 5.5vw, 32px) 32px;
  }
  .cta__alt .cta__label {
    margin-bottom: 18px;
  }
  .cta__alt-title {
    font-family: var(--jfd-font-display);
    font-size: clamp(28px, 3vw, 36px);
    font-weight: 600;
    line-height: 1.12;
    margin: 0 0 12px;
    text-wrap: pretty;
  }
  .cta__alt-body {
    font-size: 17px;
    line-height: 1.6;
    color: var(--jfd-azure-mist);
    margin: 0 0 24px;
    max-width: 40ch;
  }
  .cta__tagline {
    font-family: var(--jfd-font-mono);
    font-size: 12px;
    text-transform: uppercase;
    color: var(--jfd-azure-pale);
    margin: 32px 0 0;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.22);
    line-height: 1.8;
  }
  .cta__actions {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 20px;
  }
  .cta__button-home {
    color: var(--jfd-action-hover);
    padding: 19px clamp(20px, 5vw, 28px);
  }
  .cta__tagline--home {
    font-size: 12.5px;
    margin: 14px 0 0;
    padding-top: 0;
    border-top: 0;
    color: var(--jfd-azure-pale);
  }
</style>
