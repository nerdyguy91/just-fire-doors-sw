---
/**
 * Featured project article (home projects section): wide image, eyebrow, title, summary, three
 * stats and a link.
 */
import type { ImageMetadata } from 'astro';
import type { Stat } from '../../data/proof';
import Img from '../ui/Img.astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  position?: string;
  eyebrow: string;
  title: string;
  body: string;
  stats: Stat[];
  href: string;
  linkLabel?: string;
}

const {
  image,
  alt,
  position,
  eyebrow,
  title,
  body,
  stats,
  href,
  linkLabel = 'View project →',
} = Astro.props;
---

<article class="featured">
  <div class="featured__media">
    <Img
      src={image}
      {alt}
      {position}
      sizes="(min-width: 1240px) 560px, (min-width: 760px) 48vw, 90vw"
    />
  </div>
  <p class="featured__eyebrow">{eyebrow}</p>
  <h3 class="featured__title">{title}</h3>
  <p class="featured__body">{body}</p>
  <dl class="featured__stats">
    {stats.map((s) => (
      <div>
        <dt class="jfd-visually-hidden">{s.label}</dt>
        <dd>
          <span class="featured__value">{s.value}</span>
          <span class="featured__label" aria-hidden="true">
            {s.label}
          </span>
        </dd>
      </div>
    ))}
  </dl>
  <a class="jfd-link" {href}>
    {linkLabel}
  </a>
</article>

<style>
  .featured {
    min-width: 0;
  }
  .featured__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--jfd-media-bg);
    border: 1px solid var(--jfd-rule);
    margin-bottom: 24px;
  }
  .featured__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .featured__eyebrow {
    font-family: var(--jfd-font-mono);
    font-size: 11.5px;
    text-transform: uppercase;
    color: var(--jfd-action);
    margin: 0 0 14px;
  }
  .featured__title {
    font-family: var(--jfd-font-display);
    font-size: clamp(30px, 3.4vw, 40px);
    font-weight: 600;
    line-height: 1.16;
    margin: 0 0 16px;
    text-wrap: pretty;
  }
  .featured__body {
    font-size: 17px;
    line-height: 1.6;
    color: var(--jfd-ink-2);
    margin: 0 0 24px;
    max-width: 52ch;
    text-wrap: pretty;
  }
  .featured__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--jfd-rule);
    border: 1px solid var(--jfd-rule);
    margin: 0 0 26px;
  }
  .featured__stats > div {
    background: var(--jfd-ground);
    padding: 16px 18px;
    min-width: 0;
  }
  .featured__stats dd {
    margin: 0;
  }
  .featured__value {
    display: block;
    font-family: var(--jfd-font-display);
    font-size: 25px;
    font-weight: 600;
  }
  .featured__label {
    display: block;
    font-size: 13.5px;
    color: var(--jfd-ink-3);
    margin-top: 2px;
  }
</style>
