---
/**
 * Linked project card.
 *   stack  image on top (home projects list, /projects/ index)
 *   side   small image on the left (home credibility block)
 * The image is decorative: the card title names the project.
 */
import type { ImageMetadata } from 'astro';
import type { Tone } from '../../lib/tones';
import { toneVar } from '../../lib/tones';
import Img from '../ui/Img.astro';

interface Props {
  href: string;
  title: string;
  body: string;
  image?: ImageMetadata;
  position?: string;
  eyebrow?: string;
  meta?: string;
  /** Status line with dot, e.g. { label: 'Completed · Weston-super-Mare', tone: 'closed' } (side variant). */
  status?: { label: string; tone: Tone };
  linkLabel?: string;
  variant?: 'stack' | 'side';
}

const {
  href,
  title,
  body,
  image,
  position,
  eyebrow,
  meta,
  status,
  linkLabel = 'View project →',
  variant = 'stack',
} = Astro.props;
---

<a class:list={['pcard', `pcard--${variant}`]} {href}>
  {image && (
    <span class="pcard__media">
      <Img
        src={image}
        alt=""
        {position}
        sizes={
          variant === 'side' ? '116px' : '(min-width: 1240px) 560px, (min-width: 700px) 45vw, 90vw'
        }
        widths={variant === 'side' ? [240, 360] : undefined}
      />
    </span>
  )}
  <span class="pcard__body">
    {status && (
      <span class="pcard__status">
        <span class="pcard__dot" style={`background: ${toneVar(status.tone)}`} aria-hidden="true" />
        {status.label}
      </span>
    )}
    {eyebrow && <span class="pcard__eyebrow">{eyebrow}</span>}
    <span class="pcard__title">{title}</span>
    <span class="pcard__text">{body}</span>
    {meta && <span class="pcard__meta">{meta}</span>}
    <span class="pcard__link">{linkLabel}</span>
  </span>
</a>

<style>
  .pcard {
    display: block;
    min-width: 0;
    color: var(--jfd-graphite);
    border: 1px solid var(--jfd-rule);
    background: var(--jfd-surface);
    transition: border-color 0.2s ease;
  }
  .pcard:hover {
    border-color: var(--jfd-action);
    color: var(--jfd-graphite);
  }
  .pcard__media {
    display: block;
    overflow: hidden;
    background: var(--jfd-media-bg);
  }
  .pcard__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pcard--stack .pcard__media {
    height: 200px;
    border-bottom: 1px solid var(--jfd-rule);
  }
  .pcard--side {
    display: grid;
    grid-template-columns: 116px minmax(0, 1fr);
  }
  .pcard--side .pcard__media {
    border-right: 1px solid var(--jfd-rule);
  }
  .pcard__body {
    display: block;
    min-width: 0;
    padding: 20px 22px 22px;
  }
  .pcard--side .pcard__body {
    padding: 18px 20px;
  }
  .pcard__status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--jfd-font-mono);
    font-size: 10.5px;
    text-transform: uppercase;
    color: var(--jfd-action);
    margin-bottom: 8px;
  }
  .pcard__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .pcard__eyebrow {
    display: block;
    font-family: var(--jfd-font-mono);
    font-size: 10.5px;
    text-transform: uppercase;
    color: var(--jfd-ink-4);
    margin-bottom: 8px;
  }
  .pcard__title {
    display: block;
    font-family: var(--jfd-font-display);
    font-size: 23px;
    font-weight: 600;
    line-height: 1.24;
    margin-bottom: 8px;
  }
  .pcard--side .pcard__title {
    line-height: 1.16;
  }
  .pcard__text {
    display: block;
    font-size: 14.5px;
    color: var(--jfd-ink-3);
    line-height: 1.5;
    margin-bottom: 12px;
  }
  .pcard--side .pcard__text {
    font-size: 14px;
  }
  .pcard__meta {
    display: block;
    font-family: var(--jfd-font-mono);
    font-size: 10.5px;
    text-transform: uppercase;
    color: var(--jfd-ink-3);
    padding-top: 10px;
    border-top: 1px solid var(--jfd-meta-rule);
    margin-bottom: 12px;
    line-height: 1.6;
  }
  .pcard__link {
    display: inline-block;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--jfd-action);
    border-bottom: 1px solid var(--jfd-underline);
    padding-bottom: 2px;
  }
  .pcard--side .pcard__link {
    font-weight: 600;
  }
</style>
