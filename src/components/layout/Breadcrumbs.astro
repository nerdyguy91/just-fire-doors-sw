---
/**
 * Visible breadcrumb trail (prototype style: mono, uppercase, "/" separators). Takes the same
 * `breadcrumbs` array a page passes to BaseLayout (trail after Home), so the visible trail and the
 * BreadcrumbList JSON-LD always match. Placed inside each page hero (steps 7–8).
 */
import type { Breadcrumb } from '../../lib/seo';

interface Props {
  items: Breadcrumb[];
  class?: string;
}

const { items, class: className } = Astro.props;
const trail: Breadcrumb[] = [{ name: 'Home', path: '/' }, ...items];
---

<nav aria-label="Breadcrumb" class:list={['breadcrumbs', className]}>
  <ol role="list">
    {trail.map((item, i) =>
      i < trail.length - 1 ? (
        <li>
          <a href={item.path}>{item.name}</a>
          <span class="sep" aria-hidden="true">
            /
          </span>
        </li>
      ) : (
        <li>
          <span aria-current="page">{item.name}</span>
        </li>
      ),
    )}
  </ol>
</nav>

<style>
  ol {
    letter-spacing: normal;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--jfd-font-mono);
    font-size: 11px;
    text-transform: uppercase;
    color: var(--jfd-ink-3);
  }
  li {
    display: flex;
    gap: 8px;
  }
  a {
    color: var(--jfd-ink-3);
  }
  a:hover {
    color: var(--jfd-action);
  }
  [aria-current='page'] {
    color: var(--jfd-graphite);
  }
</style>
