---
/**
 * Analytics consent banner. Rendered only on builds with a GA4 measurement ID
 * (src/lib/analytics.ts). A modal <dialog>, opened by src/scripts/track.ts when it finds no
 * stored choice: the page behind is dimmed and inert until the visitor chooses. Escape closes it
 * for the current page only. Without JavaScript it never shows, and no analytics runs.
 *
 * Accept and reject are the same size and style (ICO guidance: rejecting must be as easy and as
 * prominent as accepting). The wording follows the build's setting: cookie-free statistics
 * before a choice (default), or nothing until accepted.
 * "Cookie settings" in the footer reopens it.
 */
import { gaCookieless } from '../../lib/analytics';
import { paths } from '../../data/paths';
---

<dialog class="consent jfd-on-dark" aria-labelledby="consent-title" data-consent-banner>
  <div class="consent__text">
    <h2 class="consent__title jfd-h3" id="consent-title" tabindex="-1">
      Analytics cookies
    </h2>
    {gaCookieless ? (
      <p>
        We count visits with Google Analytics, without cookies. Accept analytics cookies to give us
        more detail, or switch analytics off.
      </p>
    ) : (
      <p>
        We’d like to use Google Analytics to understand how this site is used. It sets cookies, so
        we only switch it on if you accept.
      </p>
    )}
    <p>
      <a href={paths.privacy}>Privacy notice</a>
    </p>
  </div>
  <div class="consent__actions">
    <button type="button" class="jfd-btn jfd-btn--lg" data-consent="granted">
      {gaCookieless ? 'Accept cookies' : 'Accept analytics'}
    </button>
    <button type="button" class="jfd-btn jfd-btn--lg" data-consent="denied">
      {gaCookieless ? 'Switch off' : 'Reject analytics'}
    </button>
  </div>
</dialog>

<script>
  import '../../scripts/track';
</script>

<style>
  .consent {
    box-sizing: border-box;
    width: min(720px, calc(100% - 32px));
    max-width: none;
    max-height: calc(100dvh - 32px);
    margin: auto;
    padding: clamp(28px, 6vw, 56px);
    overflow-y: auto;
    display: none;
    flex-direction: column;
    gap: 40px;
    background: var(--jfd-graphite);
    color: var(--jfd-dark-ink);
    border: 0;
    border-top: 4px solid var(--jfd-azure);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.45);
  }
  .consent[open] {
    display: flex;
  }
  .consent::backdrop {
    background: rgba(20, 24, 27, 0.82);
  }
  :global(html:has(.consent[open])) {
    overflow: hidden;
  }
  .consent__title {
    color: var(--jfd-dark-heading);
    margin: 0 0 16px;
  }
  .consent__title:focus {
    outline: none;
  }
  .consent__text p {
    font-size: 17px;
    line-height: 1.6;
    margin: 0 0 12px;
    max-width: 52ch;
  }
  .consent__text p:last-child {
    margin: 0;
  }
  .consent__text a {
    color: #ffffff;
    border-bottom: 1px solid rgba(255, 255, 255, 0.5);
  }
  .consent__text a:hover {
    border-bottom-color: #ffffff;
  }
  .consent__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .consent__actions .jfd-btn {
    justify-content: center;
    min-height: 60px;
  }
  @media (max-width: 479px) {
    .consent__actions {
      grid-template-columns: 1fr;
    }
  }
</style>
