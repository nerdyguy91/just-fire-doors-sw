---
/**
 * Fire Door Replacement & Installation.
 * Ported from docs/prototype/pages/service-replacement.dc.html.
 */
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import RecordFrame from '../../components/records/RecordFrame.astro';
import ProofStrip from '../../components/sections/ProofStrip.astro';
import Section from '../../components/sections/Section.astro';
import SectionHead from '../../components/sections/SectionHead.astro';
import DecisionTriad from '../../components/sections/DecisionTriad.astro';
import EvidenceBlock from '../../components/sections/EvidenceBlock.astro';
import WhyJfd from '../../components/sections/WhyJfd.astro';
import FaqList from '../../components/sections/FaqList.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import Img from '../../components/ui/Img.astro';
import { paths, projectPath } from '../../data/paths';
import { quoteHref } from '../../data/quote-routes';
import { getService } from '../../data/services';
import { faqPage, service as serviceNode } from '../../lib/schema';
import bodminWard from '../../assets/images/photos/bodmin-ward-double-doorset.jpeg';
import westonCloser from '../../assets/images/photos/weston-double-doorset-closers.jpeg';
import westonClassroom from '../../assets/images/photos/weston-classroom-double-doorset.jpeg';
import bodminInstaller from '../../assets/images/photos/bodmin-installer.jpeg';
import mammoRooms from '../../assets/images/photos/mammo-rooms.jpeg';
import mammoBlind from '../../assets/images/photos/mammo-blind-door.jpeg';
import mammoDouble from '../../assets/images/photos/mammo-double-door.jpeg';
import existingOpening from '../../assets/images/photos/existing-opening-refurbishment.jpeg';
import torbridge from '../../assets/images/photos/torbridge-doorset.jpeg';
import firestopping from '../../assets/images/evidence/dds-firestopping.jpeg';
import partsList from '../../assets/images/evidence/dds-parts-list.jpeg';

const site = Astro.site!;
const svc = getService('installation');
const faqs = (await getEntry('faqs', 'installation'))!.data;
const description =
  'Supply and installation of replacement fire doors and doorsets across Plymouth and the South West, from requirement and programme through to completion evidence.';
const quote = quoteHref(svc.quoteRoute);
const crumbs = [
  { name: 'Services', path: paths.services },
  { name: svc.shortTitle, path: svc.path },
];
const n2 = (i: number) => String(i + 1).padStart(2, '0');

const doorsetPins = [
  { x: 22, y: 16, t: 'Door closers' },
  { x: 87, y: 24, t: 'Hinges & ironmongery' },
  { x: 43, y: 30, t: 'Fire door signage' },
  { x: 35, y: 48, t: 'Fire-rated glazing' },
  { x: 55, y: 54, t: 'Lever furniture' },
  { x: 6, y: 60, t: 'Frame & seals' },
];
const supplyGroups = [
  {
    label: 'Doorset',
    pins: 'Pin 06',
    items: [
      {
        t: 'Replacement fire doors and doorsets',
        b: 'Supply and installation of the required assembly.',
      },
      { t: 'Frames', b: 'New or replacement frames where required as part of the installation.' },
      {
        t: 'Specialist doorsets',
        b: 'Where the location places additional requirements on the door.',
      },
    ],
  },
  {
    label: 'Components',
    pins: 'Pins 01–05',
    items: [
      { t: 'Ironmongery', b: 'Relevant hardware specified for the doorset.' },
      { t: 'Door closers', b: 'Installed as part of the required door setup.' },
      {
        t: 'Smoke and intumescent seals',
        b: 'Specified and installed as part of the complete assembly.',
      },
      { t: 'Glazing', b: 'Where the doorset requires fire-rated glazing.' },
    ],
  },
  {
    label: 'Finish & handover',
    pins: '',
    items: [
      { t: 'Finishes', b: 'Project-specific finishes where required.' },
      {
        t: 'Completion documentation',
        b: 'Records supporting what was installed and the work carried out.',
      },
    ],
  },
];
const phases = [
  {
    label: 'Decide',
    flex: '2 1 420px',
    tone: 'decide',
    steps: [
      {
        n: 1,
        tag: 'Requirement',
        t: 'Confirm the requirement',
        b: [
          'Start with the survey, door schedule, specification or project information already available.',
          'Clarify anything that still needs checking before the work is ordered.',
        ],
      },
      {
        n: 2,
        tag: 'Specification',
        t: 'Agree the doorset',
        b: [
          'Establish what is required for each opening, including the relevant doorset, components and finish.',
        ],
      },
    ],
  },
  {
    label: 'Deliver',
    flex: '2 1 420px',
    tone: 'onsite',
    steps: [
      {
        n: 3,
        tag: 'Programme',
        t: 'Plan the installation',
        b: [
          'Work out how the job will be sequenced around the building, access and other activity on site.',
        ],
      },
      {
        n: 4,
        tag: 'Installation',
        t: 'Install and check',
        b: ['Fit the agreed doorset and carry out the relevant installation and quality checks.'],
      },
    ],
  },
  {
    label: 'Close',
    flex: '1 1 210px',
    tone: 'closed',
    steps: [
      {
        n: 5,
        tag: 'Evidence',
        t: 'Hand back the evidence',
        b: ['Provide the agreed documentation and records supporting the completed installation.'],
      },
    ],
  },
];
const liveFactors = [
  'access to the area',
  'when individual doors can be taken out of use',
  'the order the work is completed in',
  'other contractors working nearby',
  'occupants and building users',
  'project deadlines',
];
const mammoFacts = [
  { k: 'Trigger', v: 'Significant flood damage' },
  { k: 'Core', v: 'Lead-lined' },
  { k: 'Requirement', v: 'Radiation protection' },
  { k: 'Privacy', v: 'Integrated blinds' },
];
const useCases = [
  'several doors identified for replacement through a survey',
  'one replacement phase within a larger remedial programme',
  'a refurbishment project',
  'replacements across several properties',
  'work your existing contractor cannot currently accommodate',
  'a programme that needs completing to a particular deadline',
];
const progKnow = [
  'what is scheduled',
  'which doors have been completed',
  'what is still outstanding',
  'whether anything has changed',
  'what needs a decision',
  'what happens next',
];

type DoorState = 'complete' | 'scheduled' | 'outstanding' | 'decision';
const STATE_LABEL: Record<DoorState, string> = {
  complete: 'Complete',
  scheduled: 'Scheduled',
  outstanding: 'Outstanding',
  decision: 'Decision needed',
};
const floorPattern: Record<string, string> = {
  'Level 1': 'CCCCCOOOSSSCCSSS',
  'Level 2': 'SSSSSSSSSSSDSSSS',
  Ground: 'CCCCCCDCCCCCCCCO',
};
const code: Record<string, DoorState> = {
  C: 'complete',
  S: 'scheduled',
  O: 'outstanding',
  D: 'decision',
};
const floors = Object.entries(floorPattern).map(([name, pattern]) => ({
  name,
  prefix: name === 'Ground' ? 'G' : name.slice(-1),
  doors: [...pattern].map((c) => code[c]),
}));
const counts = (['complete', 'scheduled', 'outstanding', 'decision'] as DoorState[]).map((s) => ({
  state: s,
  n: floors.reduce((acc, f) => acc + f.doors.filter((d) => d === s).length, 0),
}));

const openingPins = [
  'the condition of the existing frame',
  'opening dimensions',
  'wall construction',
  'previous alterations',
  'ironmongery',
  'glazing',
  'other site-specific conditions',
  'missing or unclear records',
];
const openingMarks = [
  { x: 47, y: 56 },
  { x: 57, y: 27 },
  { x: 82, y: 50 },
  { x: 28, y: 14 },
  { x: 51, y: 47 },
  { x: 63, y: 40 },
  { x: 10, y: 72 },
];
const found = [
  'What has been found',
  'Why it matters',
  'What needs to happen before extra work goes ahead',
];
const costFactors = [
  'doorset & specification',
  'size & configuration',
  'glazing',
  'ironmongery',
  'existing frame or opening',
  'finishes',
  'access',
  'quantity',
  'site location',
  'programme requirements',
  'specialist requirements',
];
const rvr = [
  {
    label: 'Repair',
    b: 'Where an appropriate remedial action can resolve the identified issue.',
    tone: 'closed',
  },
  {
    label: 'Replace',
    b: 'Where the existing door or doorset cannot appropriately be brought to the required condition, or the project specifically requires a new doorset.',
    tone: 'onsite',
  },
  {
    label: 'Investigate',
    b: 'Where there isn’t enough information to make the decision confidently.',
    tone: 'decide',
  },
];
---

<BaseLayout
  title="Fire Door Replacement & Installation | South West | JFD"
  {description}
  canonicalPath={svc.path}
  breadcrumbs={crumbs}
  schema={[serviceNode(site, svc, description), faqPage(site, svc.path, faqs.items)]}
>
  <PageHero
    breadcrumbs={crumbs}
    align="center"
    eyebrow="Commercial fire door installation across the South West"
  >
    <Fragment slot="title">
      Fire Door Replacement <span class="jfd-accent">&amp; Installation</span>
    </Fragment>
    <p class="hero-lead">
      Supply and installation of replacement fire doors and doorsets across the South West, with a
      clear route from the requirement through installation to completion evidence.
    </p>
    <p class="hero-body">
      Already have a fire door survey, replacement schedule or job sheet? Send it over and we can
      start with the work you already have.
    </p>
    <div class="hero-actions hero-actions--stack">
      <a class="jfd-btn" href={quote}>
        Discuss your fire door installation
      </a>
      <p class="hero-prompt">
        <span>Already have a schedule or job sheet?</span>
        <a class="jfd-link prompt-link" href={quote}>
          Send it over →
        </a>
      </p>
    </div>
    <p class="hero-tagline">One door · one site · or a defined programme of replacements</p>

    <figure slot="aside" class="hero-photo">
      <div class="hero-photo__media">
        <Img
          src={bodminWard}
          alt="New double fire doorset with vision panels installed on a hospital ward corridor, Bodmin Hospital"
          position="50% 55%"
          priority
          sizes="(min-width: 1240px) 580px, (min-width: 760px) 48vw, 90vw"
        />
        <p class="hero-photo__card">
          <span class="jfd-status jfd-status--closed">Installed · handed over</span>
          <span>Double doorset, ward corridor — live healthcare site</span>
        </p>
      </div>
      <figcaption class="caption">Bodmin Hospital · ward corridor</figcaption>
    </figure>
  </PageHero>

  <ProofStrip
    stats={[
      { value: '~150', label: 'doors replaced across two schools' },
      { value: '~35', label: 'laboratory doorsets, University of Plymouth' },
    ]}
  />

  <!-- 01 · Decide first -->
  <Section tone="tint" labelledby="decide-title">
    <SectionHead
      id="decide-title"
      layout="split"
      eyebrow="01 · Decide first"
      title="Not every defect needs a new door."
    >
      <p class="t-lead intro-17">
        Sometimes repair is the right answer. Sometimes more information is needed first. And
        sometimes the existing door or doorset genuinely needs replacing.
      </p>
      <p class="intro-strong">
        The important thing is to make that decision before the project moves into installation.
      </p>
    </SectionHead>
    <DecisionTriad
      items={[
        {
          label: 'Repair',
          body: 'Where an appropriate remedial action can resolve the identified problem.',
        },
        {
          label: 'Investigate',
          body: 'Where there isn’t enough information to confidently specify the work.',
        },
        { label: 'Replace', body: 'Where the existing door or doorset needs to be replaced.' },
      ]}
      outcome="Know what actually needs repairing or replacing, why and what the work involves."
    />
    <p class="decide__foot">
      <span>
        JFD can help establish the route forward before installation begins. Not sure whether
        replacement is required?
      </span>
      <a class="jfd-link" href={paths.inspections}>
        Fire Door Inspections &amp; Surveys →
      </a>
    </p>
  </Section>

  <!-- 02 · Supply & installation -->
  <Section tone="surface" labelledby="supply-title">
    <SectionHead
      id="supply-title"
      layout="split"
      eyebrow="02 · Supply & installation"
      title="Fire door supply and installation"
      spacing={44}
    >
      <p class="t-lead intro-17">
        Where replacement is required, JFD can supply and install the doorset needed for the
        location. Depending on the project and specification, this may include:
      </p>
    </SectionHead>
    <div class="supply">
      <figure class="pins-figure">
        <div class="pins-figure__media pins-figure__media--34">
          <Img
            src={westonCloser}
            alt="Installed double fire doorset with overhead closers, vision panels, signage and lever furniture, Weston-super-Mare school"
            sizes="(min-width: 1240px) 560px, (min-width: 760px) 48vw, 90vw"
          />
          {doorsetPins.map((p, i) => (
            <span class="pin" style={`left: ${p.x}%; top: ${p.y}%`} aria-hidden="true">
              {i + 1}
            </span>
          ))}
        </div>
        <figcaption>
          <ol class="pin-key" role="list">
            {doorsetPins.map((p, i) => (
              <li>
                <span aria-hidden="true">{i + 1}</span>
                {p.t}
              </li>
            ))}
          </ol>
          <span class="caption">Installed doorset · School, Weston-super-Mare</span>
        </figcaption>
      </figure>
      <div>
        {supplyGroups.map((g) => (
          <div class="supply__group">
            <p class="supply__label">
              <span>{g.label}</span>
              {g.pins && <span class="supply__pins">{g.pins}</span>}
            </p>
            {g.items.map((it) => (
              <div class="supply__item">
                <h3>{it.t}</h3>
                <p>{it.b}</p>
              </div>
            ))}
          </div>
        ))}
        <p class="statement-26">
          The important part is to treat the door as an installed doorset, not simply a door leaf
          that has been ordered and fitted.
        </p>
      </div>
    </div>
  </Section>

  <!-- 03 · The route -->
  <Section labelledby="route-title">
    <SectionHead
      id="route-title"
      layout="split"
      eyebrow="03 · The route"
      title="A clear route from requirement to finished installation."
      titleWidth={18}
      spacing={44}
    >
      <p class="t-lead intro-17">
        Once the replacement requirement is agreed, the project should be straightforward to follow
        — five practical steps inside JFD’s wider Decide → Deliver → Close approach.
      </p>
    </SectionHead>
    <div class="phases">
      {phases.map((ph) => (
        <div class="phase" style={`flex: ${ph.flex}`}>
          <p class="phase__label">
            <span
              class="phase__dot"
              style={`background: var(--jfd-status-${ph.tone})`}
              aria-hidden="true"
            />
            {ph.label}
          </p>
          <ol class="phase__steps" role="list">
            {ph.steps.map((st) => (
              <li>
                <span class="phase__step-head">
                  <span class="phase__n">{st.n}</span>
                  <span class="phase__tag">{st.tag}</span>
                </span>
                <h3>{st.t}</h3>
                {st.b.map((line) => (
                  <p>{line}</p>
                ))}
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
    <p class="route__flow">
      Requirement <span aria-hidden="true">→</span> Specification <span aria-hidden="true">→</span>
      Programme <span aria-hidden="true">→</span> Installation <span aria-hidden="true">→</span>
      <span class="jfd-accent">Evidence</span>
    </p>
  </Section>

  <!-- 04 · Live sites -->
  <Section tone="surface" labelledby="live-title">
    <div class="live">
      <div>
        <SectionHead
          id="live-title"
          eyebrow="04 · Live sites"
          title="Fire door installation for buildings that have to keep operating."
          titleWidth={17}
        />
        <p class="t-lead">
          Installing a replacement fire door is rarely happening in an empty building. The work may
          be taking place around staff, patients, students, residents, customers or other
          contractors.
        </p>
        <p class="t-body live__body">
          JFD has relevant experience across environments including healthcare and education, where
          the installation has to work around what is happening in the building as well as meet the
          door requirement.
        </p>
        <p class="t-mono-label live__label">That means the programme may need to consider</p>
        <ol class="live__factors" role="list">
          {liveFactors.map((f, i) => (
            <li>
              <span aria-hidden="true">{n2(i)}</span>
              {f}
            </li>
          ))}
        </ol>
      </div>
      <div class="live__photos">
        <figure>
          <div class="photo-34">
            <Img
              src={westonClassroom}
              alt="New double doorset installed beside classroom furniture in a school, Weston-super-Mare"
              sizes="(min-width: 1240px) 320px, 50vw"
              widths={[360, 640]}
            />
          </div>
          <figcaption class="caption caption--tight">Education · Weston-super-Mare</figcaption>
        </figure>
        <figure class="live__photo-low">
          <div class="photo-34">
            <Img
              src={bodminInstaller}
              alt="JFD installer checking a frame in a live hospital corridor, Bodmin"
              position="40% 45%"
              sizes="(min-width: 1240px) 270px, 45vw"
              widths={[360, 640]}
            />
          </div>
          <figcaption class="caption caption--tight">Healthcare · Bodmin Hospital</figcaption>
        </figure>
      </div>
    </div>
    <p class="live__statement">
      The installation has to work for the building as well as the fire-door requirement.
    </p>
  </Section>

  <!-- Mammography Unit -->
  <Section tone="dark" layout="split" min={340} gap={72} align="center" labelledby="mammo-title">
    <figure class="mammo__figure">
      <div class="mammo__main">
        <Img
          src={mammoRooms}
          alt="Lead-lined doorsets to Mammography Rooms 1 and 2 with radiation warning signage, Plymouth Mammography Unit"
          position="50% 45%"
          sizes="(min-width: 1240px) 580px, (min-width: 760px) 48vw, 90vw"
        />
      </div>
      <div class="mammo__pair">
        <div>
          <Img
            src={mammoBlind}
            alt="Fire doorset with integrated privacy blind in the vision panel"
            position="50% 45%"
            sizes="(min-width: 1240px) 285px, 45vw"
            widths={[360, 640]}
          />
        </div>
        <div>
          <Img
            src={mammoDouble}
            alt="Access-controlled double doorset with powered operator"
            position="50% 50%"
            sizes="(min-width: 1240px) 285px, 45vw"
            widths={[360, 640]}
          />
        </div>
      </div>
      <figcaption class="mammo__caption">
        Mammography rooms · integrated blind detail · access-controlled doorset
      </figcaption>
    </figure>
    <div>
      <p class="dark-eyebrow">Project · Healthcare · Plymouth Mammography Unit</p>
      <h2 id="mammo-title" class="mammo__title">
        When the doorset has to solve more than one problem.
      </h2>
      <p class="t-lead intro-17 mammo__p">
        Some replacement projects are straightforward. Others need the doorset to do more than
        provide fire performance.
      </p>
      <p class="t-lead intro-17 mammo__p mammo__p--last">
        At Plymouth Mammography Unit, JFD’s work followed significant flood damage and included
        specialist replacement doors with{' '}
        <strong>lead-lined cores for radiation protection and integrated blinds for privacy</strong>
        .
      </p>
      <dl class="mammo__facts">
        {mammoFacts.map((f) => (
          <div>
            <dt>{f.k}</dt>
            <dd>{f.v}</dd>
          </div>
        ))}
      </dl>
      <p class="mammo__statement">
        The right doorset has to work for the room, the building and the people using it.
      </p>
      <a class="jfd-link jfd-link--on-dark" href={projectPath('plymouth-mammography-unit')}>
        See the project →
      </a>
    </div>
  </Section>

  <!-- 05 · Where you're starting from -->
  <Section layout="split" min={340} labelledby="starting-title">
    <div>
      <SectionHead
        id="starting-title"
        eyebrow="05 · Where you’re starting from"
        title="One replacement or a defined programme of work."
        titleWidth={16}
      />
      <p class="t-lead intro-17 starting__lead">
        JFD can start with the piece of work that needs progressing now. That could be one door, one
        building or a defined package across several sites.
      </p>
      <p class="intro-strong starting__strong">
        You don’t need to move your whole fire-door programme to JFD in order to get a replacement
        project moving.
      </p>
      <a class="jfd-btn jfd-btn--sm" href={quote}>
        Send us your replacement schedule
      </a>
    </div>
    <div>
      <p class="t-mono-label starting__label">You may have</p>
      <ol class="cases" role="list">
        {useCases.map((u, i) => (
          <li>
            <span aria-hidden="true">{n2(i)}</span>
            <span>{u}</span>
          </li>
        ))}
      </ol>
    </div>
  </Section>

  <!-- 06 · Deliver -->
  <Section tone="surface" layout="split" min={340} gap={72} labelledby="deliver-title">
    <div class="deliver-text">
      <SectionHead
        id="deliver-title"
        eyebrow="06 · Deliver"
        title="Get the installation done without losing sight of the programme."
        titleWidth={17}
      />
      <p class="t-lead intro-17 deliver-text__intro">
        A replacement programme needs more than somebody arriving on site with the right doors. The
        Estates or project team also needs to know:
      </p>
      <ul class="ruled-list deliver-text__list" role="list">
        {progKnow.map((p) => (
          <li>{p}</li>
        ))}
      </ul>
      <p class="t-body deliver-text__body">
        Once the scope is agreed, the installation programme should give you a clear view of
        progress as the work moves across the site.
      </p>
      <p class="statement-26">
        Get the work done with a clear view of what’s complete along the way.
      </p>
    </div>
    <RecordFrame
      title="Replacement programme · door status"
      meta="48 doorsets · week 3"
      shadow
      caption="Illustrative example"
    >
      <ul class="doors-legend" role="list">
        {counts.map((c) => (
          <li class={`is-${c.state}`}>
            <span class="doors-legend__key" aria-hidden="true" />
            {STATE_LABEL[c.state]} · {c.n}
          </li>
        ))}
      </ul>
      {floors.map((f) => (
        <div class="floor">
          <span class="floor__name">{f.name}</span>
          <div class="floor__doors" aria-hidden="true">
            {f.doors.map((d, i) => (
              <span
                class={`door-cell is-${d}`}
                title={`${f.prefix}-${String(i + 1).padStart(2, '0')} · ${STATE_LABEL[d]}`}
              >
                {f.prefix}-{String(i + 1).padStart(2, '0')}
              </span>
            ))}
          </div>
        </div>
      ))}
      <p class="doors-note">
        <strong>2 decisions needed</strong> · G-07 frame condition, 2-12 opening size — raised with
        photos before work continues
      </p>
    </RecordFrame>
  </Section>

  <!-- 07 · Existing openings -->
  <Section layout="split" min={340} gap={72} labelledby="openings-title">
    <div>
      <SectionHead
        id="openings-title"
        eyebrow="07 · Existing openings"
        title="Replacement isn’t always just taking one door out and putting another in."
        titleWidth={17}
      />
      <p class="t-lead intro-17 openings__intro">
        Existing buildings can throw up surprises. Once work starts, the opening itself may need
        more attention than expected. That could involve:
      </p>
      <ol class="openings__list" role="list">
        {openingPins.map((o, i) => (
          <li>
            <span
              class:list={['openings__n', { 'is-open': i === openingPins.length - 1 }]}
              aria-hidden="true"
            >
              {i + 1}
            </span>
            {o}
          </li>
        ))}
      </ol>
      <p class="t-muted openings__next">
        The key thing is what happens next. If something changes the agreed scope, you should
        understand:
      </p>
      <ol class="found" role="list">
        {found.map((f, i) => (
          <li>
