---
/**
 * Fire Door Maintenance.
 * Ported from docs/prototype/pages/service-maintenance.dc.html.
 */
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import RecordFrame from '../../components/records/RecordFrame.astro';
import ProofStrip from '../../components/sections/ProofStrip.astro';
import Section from '../../components/sections/Section.astro';
import SectionHead from '../../components/sections/SectionHead.astro';
import EvidenceBlock from '../../components/sections/EvidenceBlock.astro';
import WhyJfd from '../../components/sections/WhyJfd.astro';
import FaqList from '../../components/sections/FaqList.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import { paths } from '../../data/paths';
import { quoteHref } from '../../data/quote-routes';
import { getService } from '../../data/services';
import { faqPage, service as serviceNode } from '../../lib/schema';
import pubCloser from '../../assets/images/photos/pub-closer.jpeg';
import installChecks from '../../assets/images/evidence/dds-install-checks.jpeg';
import partsList from '../../assets/images/evidence/dds-parts-list.jpeg';

const site = Astro.site!;
const svc = getService('maintenance');
const faqs = (await getEntry('faqs', 'maintenance'))!.data;
const description =
  'Planned fire door maintenance for commercial buildings and estates across Plymouth and the South West. Move from reactive repairs to a clear, recorded programme.';
const quote = quoteHref(svc.quoteRoute);
const crumbs = [
  { name: 'Services', path: paths.services },
  { name: svc.shortTitle, path: svc.path },
];

/** Status colours used by this page's illustrative records (includes action blue). */
const TONE = {
  closed: 'var(--jfd-status-closed)',
  onsite: 'var(--jfd-status-onsite)',
  decide: 'var(--jfd-status-decide)',
  neutral: 'var(--jfd-status-neutral)',
  action: 'var(--jfd-action)',
} as const;
type ToneKey = keyof typeof TONE;
const CELL = {
  done: 'var(--jfd-status-closed)',
  scheduled: 'var(--jfd-action)',
  none: 'var(--jfd-surface)',
} as const;
type Cell = keyof typeof CELL;
const n2 = (i: number) => String(i + 1).padStart(2, '0');

const sites: { name: string; meta: string; q: Cell[]; status: string; tone: ToneKey }[] = [
  {
    name: 'Site A · Secondary school',
    meta: '112 doors',
    q: ['done', 'done', 'scheduled', 'none'],
    status: 'Scheduled',
    tone: 'action',
  },
  {
    name: 'Site B · Health centre',
    meta: '86 doors',
    q: ['done', 'done', 'done', 'scheduled'],
    status: 'Checked',
    tone: 'closed',
  },
  {
    name: 'Site C · Offices',
    meta: '54 doors',
    q: ['done', 'scheduled', 'none', 'scheduled'],
    status: 'Approval req.',
    tone: 'decide',
  },
  {
    name: 'Site D · Primary school',
    meta: '48 doors',
    q: ['done', 'none', 'scheduled', 'none'],
    status: 'Complete',
    tone: 'closed',
  },
  {
    name: 'Site E · Depot',
    meta: '38 doors',
    q: ['done', 'none', 'none', 'scheduled'],
    status: 'Outstanding',
    tone: 'onsite',
  },
  {
    name: 'Site F · Library',
    meta: '74 doors',
    q: ['scheduled', 'none', 'scheduled', 'none'],
    status: 'Scheduled',
    tone: 'action',
  },
];
const cellLabel = { done: 'visit complete', scheduled: 'scheduled', none: 'not due' } as const;

const reactive = [
  { date: '14 Jan', t: 'Closer not latching, stair 2', src: 'Caretaker', indent: 0, width: 100 },
  { date: '02 Feb', t: '7 actions from annual survey', src: 'Survey', indent: 24, width: 92 },
  { date: '19 Feb', t: 'Seal damaged, kitchen', src: 'Email', indent: 8, width: 86 },
  { date: '03 Mar', t: 'Door catching on frame, L2', src: 'Helpdesk', indent: 40, width: 88 },
  { date: '11 Mar', t: 'Hinge screw missing, corridor', src: 'Contractor', indent: 16, width: 90 },
  { date: '??', t: 'Previous repair — no record', src: 'Unknown', indent: 32, width: 84 },
];
const planned = [
  { t: 'Finding issues', b: 'Scheduled checks across the doors in the programme.' },
  { t: 'Deciding what needs doing', b: 'Maintain, repair, replace or investigate.' },
  { t: 'Completing the work', b: 'Agreed maintenance and remedial work carried out.' },
  { t: 'Keeping the records up to date', b: 'One record per door, ready for the next cycle.' },
];
const maintGroups = [
  {
    label: 'Check',
    items: [
      {
        t: 'Checking existing fire doors',
        b: 'Looking for changes in condition, wear or issues requiring attention.',
      },
    ],
  },
  {
    label: 'Maintain',
    items: [
      { t: 'Door closers', b: 'Adjustment, maintenance or replacement where appropriate.' },
      { t: 'Hinges', b: 'Addressing worn or damaged hinges and associated issues.' },
      {
        t: 'Smoke and intumescent seals',
        b: 'Replacing damaged, missing or worn seals where required.',
      },
      {
        t: 'Gaps and alignment',
        b: 'Adjusting doors where a suitable maintenance solution is available.',
      },
      { t: 'Latches and ironmongery', b: 'Maintaining or replacing relevant hardware.' },
      {
        t: 'Minor damage and adjustments',
        b: 'Dealing with straightforward defects before they simply sit on the action list.',
      },
    ],
  },
  {
    label: 'Escalate',
    items: [
      {
        t: 'Remedial works',
        b: 'Moving identified issues into an agreed repair programme where more work is needed.',
      },
      {
        t: 'Replacement',
        b: 'Where maintenance or repair is no longer the right action, the door can be moved into a replacement scope.',
      },
    ],
  },
  {
    label: 'Record',
    items: [
      {
        t: 'Completion records',
        b: 'Keeping a clearer record of what was identified and what was dealt with.',
      },
    ],
  },
];
const cycle = [
  {
    label: 'Decide',
    b: 'Identify new defects and work out what needs maintenance, repair, replacement or further investigation.',
    tone: 'decide' as const,
  },
  {
    label: 'Deliver',
    b: 'Complete the agreed maintenance and remedial work.',
    tone: 'onsite' as const,
  },
  {
    label: 'Close',
    b: 'Record what was done, retain the relevant evidence and make anything still outstanding clear.',
    tone: 'closed' as const,
  },
];
const visibility: { label: string; n: string; d: string; tone: ToneKey }[] = [
  { label: 'Scheduled', n: '86', d: 'doors in this visit', tone: 'action' },
  { label: 'Checked', n: '64', d: 'checked so far', tone: 'neutral' },
  { label: 'Completed', n: '41', d: 'maintenance done', tone: 'closed' },
  { label: 'New issue', n: '9', d: 'identified this visit', tone: 'onsite' },
  { label: 'Approval', n: '3', d: 'remedials to approve', tone: 'decide' },
  { label: 'Outstanding', n: '5', d: 'still open', tone: 'onsite' },
  { label: 'Evidence', n: '41', d: 'records with photos', tone: 'closed' },
  { label: 'Next step', n: '14 May', d: 'next visit booked', tone: 'action' },
];
const doorLog: { id: string; t: string; status: string; tone: ToneKey }[] = [
  { id: 'FD30-B02', t: 'Closer adjusted, latching checked', status: 'Completed', tone: 'closed' },
  { id: 'FD30-B09', t: 'Seal worn at hinge side — replaced', status: 'Completed', tone: 'closed' },
  {
    id: 'FD60-B14',
    t: 'Frame damaged — remedial quote issued',
    status: 'Approval req.',
    tone: 'decide',
  },
  { id: 'FD30-B21', t: 'Leaf dropping — hinges to replace', status: 'New issue', tone: 'onsite' },
];
const remedials = [
  {
    t: 'Pick up wear and defects earlier',
    b: 'So issues become visible rather than quietly sitting unnoticed.',
  },
  {
    t: 'Deal with straightforward maintenance as it appears',
    b: 'Rather than allowing every small problem to join the next large remedial programme.',
  },
  {
    t: 'Spot larger requirements sooner',
    b: 'If a door needs more significant repair, investigation or replacement, the requirement becomes visible earlier.',
  },
  {
    t: 'Keep a clearer action list',
    b: 'So the estate is easier to manage between larger inspection cycles.',
  },
];
const steps = [
  { t: 'One commercial building', h: 120 },
  { t: 'A few priority sites', h: 170 },
  { t: 'A regional group of properties', h: 230 },
];
const altStarts = [
  'An existing remedial backlog',
  'A scheduled inspection & maintenance cycle',
  'Capacity alongside your contractor',
];
const freqFactors = [
  'the type and use of the building',
  'how heavily the doors are used',
  'their condition',
  'the risks within the premises',
  'the inspection or checking requirements that apply',
];
const escalate: { label: string; t: string; b: string; tone: ToneKey }[] = [
  {
    label: 'Maintain',
    t: 'Adjustment or routine maintenance',
    b: 'A straightforward issue that can be dealt with appropriately.',
    tone: 'action',
  },
  {
    label: 'Repair',
    t: 'Remedial repair',
    b: 'More involved work that needs to be scoped and completed.',
    tone: 'closed',
  },
  {
    label: 'Investigate',
    t: 'Further investigation',
    b: 'Where more information is needed before the right action can be confirmed.',
    tone: 'decide',
  },
  {
    label: 'Replace',
    t: 'Replacement',
    b: 'Where the existing door or doorset is no longer suitable for repair.',
    tone: 'onsite',
  },
];
const startPoints = [
  { t: 'One site', b: 'Start with a building that currently needs attention.' },
  {
    t: 'A priority group of properties',
    b: 'Focus on the part of the estate creating the most work.',
  },
  {
    t: 'An existing remedial backlog',
    b: 'Bring the immediate issues back under control before establishing the recurring programme.',
  },
  {
    t: 'A scheduled maintenance cycle',
    b: 'Put a clearer rhythm around inspections and maintenance.',
  },
  {
    t: 'Overflow work',
    b: 'Use JFD alongside your existing supplier where you need extra capacity.',
  },
  {
    t: 'A defined trial',
    b: 'Start with a manageable piece of the estate before deciding whether to extend the relationship.',
  },
];
---

<BaseLayout
  title="Fire Door Maintenance | South West | Just Fire Doors"
  {description}
  canonicalPath={svc.path}
  breadcrumbs={crumbs}
  schema={[serviceNode(site, svc, description), faqPage(site, svc.path, faqs.items)]}
>
  <PageHero
    breadcrumbs={crumbs}
    size="large"
    eyebrow="Commercial fire door maintenance across the South West"
  >
    <Fragment slot="title">
      Fire Door <span class="jfd-accent">Maintenance</span>
    </Fragment>
    <p class="hero-lead">
      Keep your fire doors functioning properly and your outstanding actions under control with a
      clearer programme of inspections, maintenance and remedial work.
    </p>
    <p class="hero-body">
      From one building to a multi-site estate, JFD can help you move away from repeated reactive
      repairs and towards a more manageable way of looking after your fire doors.
    </p>
    <div class="hero-actions hero-actions--stack">
      <a class="jfd-btn" href={quote}>
        Discuss your fire door maintenance
      </a>
      <p class="hero-prompt">
        <span>Already have outstanding remedials?</span>
        <a class="jfd-link prompt-link" href={quoteHref('backlog')}>
          Send us your job sheet →
        </a>
      </p>
    </div>

    <RecordFrame
      slot="aside"
      title="Maintenance programme · 2026–27"
      meta="6 sites · 412 doors"
      shadow
      caption="Illustrative example"
    >
      <table class="plan">
        <caption class="jfd-visually-hidden">
          Illustrative maintenance programme: each site, quarterly visits and current status
        </caption>
        <thead>
          <tr>
            <th scope="col">Site</th>
            <th scope="col">Q1</th>
            <th scope="col">Q2</th>
            <th scope="col">Q3</th>
            <th scope="col">Q4</th>
            <th scope="col">Now</th>
          </tr>
        </thead>
        <tbody>
          {sites.map((s) => (
            <tr>
              <td>
                <span class="plan__name">{s.name}</span>
                <span class="plan__meta">{s.meta}</span>
              </td>
              {s.q.map((c) => (
                <td class="plan__q">
                  <span class="plan__cell" style={`background: ${CELL[c]}`}>
                    <span class="jfd-visually-hidden">{cellLabel[c]}</span>
                  </span>
                </td>
              ))}
              <td>
                <span class="dot-label" style={`color: ${TONE[s.tone]}`}>
                  {s.status}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="plan__legend" aria-hidden="true">
        <span>
          <span class="plan__key" style={`background: ${CELL.done}`}></span>Visit complete
        </span>
        <span>
          <span class="plan__key" style={`background: ${CELL.scheduled}`}></span>Scheduled
        </span>
        <span>
          <span class="plan__key plan__key--none"></span>Not due
        </span>
      </p>
    </RecordFrame>
  </PageHero>

  <ProofStrip />

  <!-- 01 · Reactive → planned -->
  <Section labelledby="planned-title">
    <SectionHead
      id="planned-title"
      layout="split"
      eyebrow="01 · Reactive → planned"
      title="Move from reactive repairs to a clearer maintenance programme."
      titleWidth={18}
      spacing={44}
    >
      <p class="t-lead intro-17">
        One repair gets raised. Then another survey adds a few more actions. A closer stops working.
        A seal is damaged. A door starts catching. Someone adds it to the list for later.
      </p>
      <p class="intro-strong">
        None of those issues feels enormous on its own. The problem is how easily they build up.
      </p>
    </SectionHead>
    <div class="contrast">
      <div class="contrast__col contrast__col--reactive">
        <p class="contrast__head">
          <span>Reactive</span>
          <span class="contrast__rule" aria-hidden="true"></span>
          <span class="contrast__meta">6 open · 5 sources</span>
        </p>
        <ul class="reactive" role="list">
          {reactive.map((r) => (
            <li style={`margin-left: ${r.indent}px; max-width: ${r.width}%`}>
              <span class="reactive__date">{r.date}</span>
              <span class="reactive__t">{r.t}</span>
              <span class="reactive__src">{r.src}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="contrast__col">
        <p class="contrast__head contrast__head--planned">
          <span>Planned</span>
          <span class="contrast__rule" aria-hidden="true"></span>
          <span class="contrast__meta">One programme · one record</span>
        </p>
        <ol class="planned" role="list">
          {planned.map((p, i) => (
            <li>
              <span class="planned__rail" aria-hidden="true">
                <span class:list={['planned__n', { 'is-filled': i === planned.length - 1 }]}>
                  {n2(i)}
                </span>
                {i < planned.length - 1 && <span class="planned__line" />}
              </span>
              <span class="planned__text">
                <span class="planned__t">{p.t}</span>
                <span class="planned__b">{p.b}</span>
              </span>
            </li>
          ))}
        </ol>
      </div>
    </div>
    <p class="t-lead contrast__outro">
      A planned fire door maintenance approach gives your Estates or Facilities team a clearer
      rhythm — so instead of repeatedly catching up with the fire-door list,{' '}
      <strong>you can keep it under better control.</strong>
    </p>
  </Section>

  <!-- 02 · Scope -->
  <Section tone="surface" labelledby="includes-title">
    <SectionHead
      id="includes-title"
      layout="split"
      eyebrow="02 · Scope"
      title="What does fire door maintenance include?"
      titleWidth={18}
      spacing={44}
    >
      <p class="t-lead intro-17">
        Fire door maintenance is about keeping the whole door assembly working as intended, not
        simply booking an annual visit. Depending on the doors and the work identified, maintenance
        can include:
      </p>
    </SectionHead>
    <div class="groups">
      {maintGroups.map((g, gi) => (
        <div class="groups__col">
          <p class="groups__label">
            <span class="groups__n" aria-hidden="true">
              {n2(gi)}
            </span>
            <span>{g.label}</span>
          </p>
          {g.items.map((it) => (
            <div class="groups__item">
              <h3>{it.t}</h3>
              <p>{it.b}</p>
            </div>
          ))}
        </div>
      ))}
    </div>
    <div class="pair">
      <p class="pair__lead">The individual tasks matter.</p>
      <p class="pair__statement">
        But the bigger benefit is knowing they are being picked up as part of an organised programme
        rather than waiting until somebody notices the next problem.
      </p>
    </div>
  </Section>

  <!-- 03 · The cycle -->
  <Section tone="dark" labelledby="cycle-title">
    <div class="cycle__head">
      <div>
        <p class="dark-eyebrow">03 · The cycle</p>
        <h2 id="cycle-title" class="cycle__title">
          Know what needs attention, what’s been dealt with and what comes next.
        </h2>
      </div>
      <p class="t-lead intro-17 cycle__intro">
        A maintenance programme should leave your estate clearer than it was before. JFD’s wider
        approach follows three straightforward stages:
      </p>
    </div>
    <ol class="cycle" role="list">
      {cycle.map((c) => (
        <li>
          <div class="cycle__label-row">
            <span class="cycle__dot" style={`background: ${TONE[c.tone]}`} aria-hidden="true" />
            <h3>{c.label}</h3>
            <span class="cycle__rule" aria-hidden="true" />
            <span class="cycle__arrow" aria-hidden="true">
              →
            </span>
          </div>
          <p>{c.b}</p>
        </li>
      ))}
    </ol>
    <div class="cycle__return" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>
    <p class="cycle__repeat">Then repeat when the next inspection or maintenance activity is due</p>
    <div class="pair pair--dark">
      <p class="pair__lead">The point isn’t simply to have somebody visit the site regularly.</p>
      <p class="pair__statement">
        It’s to keep a clearer handle on the condition of the doors and the work that still needs
        doing.
      </p>
    </div>
  </Section>

  <!-- 04 · Visibility -->
  <Section layout="split" min={340} gap={72} labelledby="visibility-title">
    <div class="vis-text">
      <SectionHead
        id="visibility-title"
        eyebrow="04 · Visibility"
        title="A maintenance programme shouldn’t create more chasing."
        titleWidth={16}
      />
      <p class="t-muted vis-text__small">The useful question for an Estates team isn’t just:</p>
      <p class="vis-text__old">“Has somebody been out?”</p>
      <p class="t-muted vis-text__small">It’s:</p>
      <p class="vis-text__new">“What has actually happened?”</p>
      <p class="t-body vis-text__body">
        A clear maintenance programme should make it easy to see the position without pulling apart
        emails, job sheets and contractor updates every time someone asks.
      </p>
      <p class="vis-text__statement">
        Get the work done with a clear view of what’s complete along the way.
      </p>
    </div>
    <RecordFrame
      title="Site B · Visit 3 of 4"
      meta="86 doors"
      shadow
      caption="Illustrative example"
    >
      <dl class="vis-stats">
        {visibility.map((v) => (
          <div>
            <dt>
              <span class="dot-label dot-label--sm" style={`color: ${TONE[v.tone]}`}>
                {v.label}
              </span>
            </dt>
            <dd>
              <span class="vis-stats__n">{v.n}</span>
              <span class="vis-stats__d">{v.d}</span>
            </dd>
          </div>
        ))}
      </dl>
      <table class="log">
        <caption class="jfd-visually-hidden">
          Illustrative visit log: each door, the work and its status
        </caption>
        <thead class="jfd-visually-hidden">
          <tr>
            <th scope="col">Door</th>
            <th scope="col">Work</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          {doorLog.map((d) => (
            <tr>
              <td class="log__id">{d.id}</td>
              <td class="log__t">{d.t}</td>
              <td>
                <span class="dot-label dot-label--sm" style={`color: ${TONE[d.tone]}`}>
                  {d.status}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </RecordFrame>
  </Section>

  <!-- 05 · Remedials -->
  <Section tone="surface" labelledby="remedials-title">
    <SectionHead
      id="remedials-title"
      layout="split"
      eyebrow="05 · Remedials"
      title="Keep remedials manageable."
      spacing={44}
    >
      <p class="t-lead intro-17 remedials__intro">
        A maintenance programme won’t mean fire doors never develop faults. It can mean you are less
        likely to discover a growing pile of them all at once.
      </p>
      <p class="t-muted">Regular inspection and maintenance can help you:</p>
    </SectionHead>
    <ol class="remedials" role="list">
      {remedials.map((r, i) => (
        <li>
          <span class="remedials__n" aria-hidden="true">
            {n2(i)}
          </span>
          <h3>{r.t}</h3>
          <p>{r.b}</p>
        </li>
      ))}
    </ol>
    <p class="callout">
      <span>Already dealing with an accumulated list?</span>
      <a class="jfd-link" href={paths.remedialWorks}>
        See Fire Door Repairs &amp; Remedial Works →
      </a>
    </p>
  </Section>

  <!-- 06 · Estate fit -->
  <Section layout="split" min={340} align="end" labelledby="estate-title">
    <div>
      <SectionHead
        id="estate-title"
        eyebrow="06 · Estate fit"
        title="A maintenance approach that can work across your estate."
        titleWidth={18}
      />
      <p class="t-lead intro-17 estate__lead">
        JFD can help shape the work around the estate you actually manage.
      </p>
      <p class="t-muted estate__muted">
        That might mean starting small, proving the approach and then extending it across more sites
        where it makes sense.
      </p>
      <p class="estate__statement">You don’t need to move everything to JFD on day one.</p>
    </div>
    <div>
      <p class="t-mono-label estate__label">Your maintenance requirement might start with</p>
      <ol class="steps" role="list">
        {steps.map((s, i) => (
          <li class:list={{ 'is-last': i === steps.length - 1 }} style={`height: ${s.h}px`}>
            <span class="steps__n">Step {n2(i)}</span>
            <span class="steps__t">{s.t}</span>
          </li>
        ))}
      </ol>
      <p class="t-mono-label estate__or">Or start from</p>
      <ul class="chips" role="list">
        {altStarts.map((a) => (
          <li class="jfd-chip">{a}</li>
        ))}
      </ul>
    </div>
  </Section>

  <!-- 07 · Frequency / 08 · Escalation -->
  <Section tone="surface" layout="split" min={340} labelledby="frequency-title">
    <div>
      <p class="jfd-eyebrow">07 · Frequency</p>
      <h2 id="frequency-title" class="qa__title">
        How often do fire doors need checking and maintaining?
      </h2>
      <p class="qa__strong">
        There isn’t one maintenance interval that makes sense for every building and every door.
      </p>
      <p class="qa__body qa__body--tight">
        How often fire doors need checking can depend on factors including:
      </p>
      <ul class="ruled-list qa__list" role="list">
        {freqFactors.map((f) => (
          <li>{f}</li>
        ))}
      </ul>
      <p class="qa__body">
        A routine check is also not necessarily the same thing as a more detailed inspection by a
        competent person, and maintenance itself should respond to what the door actually needs.
      </p>
      <p class="qa__body qa__body--last">
        JFD can help you understand the current condition of your doors and put together a sensible
        inspection and maintenance approach for the estate.
      </p>
      <a class="jfd-link" href={paths.inspections}>
        Fire Door Inspections &amp; Surveys →
      </a>
    </div>
    <div>
      <p class="jfd-eyebrow">08 · Escalation</p>
      <h2 class="qa__title">What happens when maintenance finds a bigger problem?</h2>
      <p class="qa__body qa__body--last">
