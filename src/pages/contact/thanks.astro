---
/**
 * /contact/thanks/. Where /api/enquiry redirects after a contact form sent without JavaScript
 * (with JavaScript the success state shows in the page). noindex, not in the sitemap. Copy is the
 * prototype's contact success state.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import { business } from '../../data/business';
import { paths } from '../../data/paths';

const { phone } = business;
const crumbs = [
  { name: 'Contact', path: paths.contact },
  { name: 'Message received', path: `${paths.contact}thanks/` },
];
---

<BaseLayout
  title="Message received | Just Fire Doors"
  description="Thanks for contacting Just Fire Doors SW. We’ve received your message and will use the details you provided to get back to you."
  breadcrumbs={crumbs}
  noindex
>
  <PageHero breadcrumbs={crumbs} size="large">
    <Fragment slot="title">
      Thanks. <span class="jfd-accent">We’ve got your message.</span>
    </Fragment>
    <p
      class="jfd-status jfd-status--closed thanks__status"
      data-track-load="form_submit_success"
      data-form="contact"
    >
      Message received
    </p>
    <p class="hero-lead">
      The JFD team will use the details you’ve provided to understand the enquiry and get back to
      you.
    </p>
    <div class="hero-actions thanks__actions">
      {phone && (
        <span>
          Something urgent?{' '}
          <a class="jfd-link" href={`tel:${phone.e164}`} data-track="tel">
            Call {phone.display}
          </a>
        </span>
      )}
      <a class="jfd-link" href={paths.projects}>
        See our projects →
      </a>
      <a class="jfd-link" href={`${paths.contact}#message`}>
        Send another message →
      </a>
    </div>
  </PageHero>
</BaseLayout>

<style>
  .thanks__status {
    display: flex;
    margin: 0 0 16px;
  }
  .thanks__actions {
    margin-top: 28px;
  }
</style>
