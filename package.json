{
  "name": "just-fire-doors",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Just Fire Doors SW website: static Astro build on Cloudflare Pages",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test \"tests/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:html": "html-validate \"dist/**/*.html\"",
    "check:dist": "node scripts/check-dist.mjs",
    "lhci": "lhci autorun",
    "a11y": "node scripts/a11y.mjs",
    "ci": "npm run format:check && npm run check && npm test && npm run build && npm run lint:html && npm run check:dist",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@lhci/cli": "^0.15.1",
    "html-validate": "^11.17.0",
    "pa11y-ci": "^5.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild": true
  }
}
