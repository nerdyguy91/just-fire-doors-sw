# Copy to .dev.vars for `wrangler pages dev`, and set the real values in the
# Cloudflare Pages dashboard (separately for Preview and Production).
# Never commit real secrets.

# Canonical origin used by Astro for canonicals, sitemap and OG URLs (build time)
PUBLIC_SITE_URL=https://justfiredoors.co.uk

# Google Analytics 4 measurement ID (build time), e.g. G-XXXXXXXXXX. Leave empty for no analytics:
# the site then ships no analytics code and no consent banner.
PUBLIC_GA_MEASUREMENT_ID=
# Before the visitor chooses in the banner: "cookieless" (default) sends cookie-free GA4 pings;
# "off" loads nothing from Google until they accept.
PUBLIC_GA_BEFORE_CONSENT=cookieless

# Turnstile (use Cloudflare's test keys locally)
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Enquiry email (Resend)
RESEND_API_KEY=
FORM_TO_EMAIL=
FORM_FROM_EMAIL=
# Local testing only: post the email to a mock endpoint instead of Resend. Never set in Cloudflare.
# RESEND_API_URL=http://127.0.0.1:8799/emails

# Signed upload sessions and download links (32 random bytes, e.g. `openssl rand -hex 32`)
FILE_LINK_SECRET=
FILE_LINK_TTL_DAYS=30

# Upload limits
UPLOAD_MAX_FILE_MB=50
UPLOAD_MAX_FILES=10

# R2 bucket binding (UPLOADS) is configured in wrangler.toml / the Pages dashboard, not here.
