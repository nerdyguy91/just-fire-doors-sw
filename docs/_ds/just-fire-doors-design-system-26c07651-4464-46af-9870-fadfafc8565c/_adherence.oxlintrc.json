{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/content/**",
              "components/layout/**",
              "components/media/**",
              "components/navigation/**",
              "components/records/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Barlow Condensed|Barlow|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Barlow Condensed, Barlow, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|inverse|ghostDark)$/]",
        "message": "<Button> variant must be one of 'primary' | 'inverse' | 'ghostDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|media|mediaLabel|index|title|meta|style|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: href, media, mediaLabel, index, title, meta, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:style|children|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Flow'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|style|key|ref|className|style|children)$/]",
        "message": "<Flow> doesn't accept that prop. Declared props: steps, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HairlineGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|style|children|key|ref|className|style|children)$/]",
        "message": "<HairlineGrid> doesn't accept that prop. Declared props: columns, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Heading'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|eyebrow|accent|style|eyebrowStyle|children|key|ref|className|style|children)$/]",
        "message": "<Heading> doesn't accept that prop. Declared props: level, eyebrow, accent, style, eyebrowStyle, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Heading'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:h1|h2|h3|statement)$/]",
        "message": "<Heading> level must be one of 'h1' | 'h2' | 'h3' | 'statement'."
      },
      {
        "selector": "JSXOpeningElement[name.name='JobRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|status|statusLabel|key|ref|className|style|children)$/]",
        "message": "<JobRow> doesn't accept that prop. Declared props: id, label, status, statusLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='JobRow'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:closed|onsite|decide|neutral)$/]",
        "message": "<JobRow> status must be one of 'closed' | 'onsite' | 'decide' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NumberedRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|title|children|key|ref|className|style|children)$/]",
        "message": "<NumberedRow> doesn't accept that prop. Declared props: index, title, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Photo'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|ratio|placeholder|caption|style|key|ref|className|style|children)$/]",
        "message": "<Photo> doesn't accept that prop. Declared props: src, ratio, placeholder, caption, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Photo'] > JSXAttribute[name.name='ratio'] > Literal[value!=/^(?:16x10|5x4|4x3)$/]",
        "message": "<Photo> ratio must be one of '16x10' | '5x4' | '4x3'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|id|style|innerStyle|children|key|ref|className|style|children)$/]",
        "message": "<Section> doesn't accept that prop. Declared props: tone, id, style, innerStyle, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ground|surface|tint|dark|action)$/]",
        "message": "<Section> tone must be one of 'ground' | 'surface' | 'tint' | 'dark' | 'action'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|links|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: title, links."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|id|items|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: label, id, items."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|style|key|ref|className|style|children)$/]",
        "message": "<Stat> doesn't accept that prop. Declared props: value, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|children|key|ref|className|style|children)$/]",
        "message": "<StatusBadge> doesn't accept that prop. Declared props: status, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:closed|onsite|decide|neutral)$/]",
        "message": "<StatusBadge> status must be one of 'closed' | 'onsite' | 'decide' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:onDark|href|children|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: onDark, href, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:suffix|color|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: suffix, color."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
