{
  "extends": ["html-validate:recommended"],
  "rules": {
    "no-inline-style": "off",
    "tel-non-breaking": "off",
    "no-redundant-role": ["error", { "exclude": ["list"] }],
    "prefer-native-element": [
      "error",
      { "exclude": ["list", "table", "row", "cell", "columnheader"] }
    ]
  }
}
